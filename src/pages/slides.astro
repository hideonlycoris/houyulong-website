---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="网址后台" description="内部管理后台">
  <!-- 登录模态框 -->
  <div id="login-modal" class="modal">
    <div class="modal-content">
      <h2>🔐 访问验证</h2>
      <p>请输入访问密码</p>
      <input type="password" id="password-input" placeholder="请输入密码" />
      <button id="login-btn" class="btn-primary">验证</button>
      <p id="login-error" class="error hidden">密码错误，请重试</p>
    </div>
  </div>

  <!-- 主内容 -->
  <div id="main-content" class="hidden">
    <div class="header">
      <h1>🔧 网址后台</h1>
      <button id="logout-btn" class="btn-logout">退出</button>
    </div>

    <!-- 上传区域 -->
    <div class="upload-section">
      <div class="upload-area" id="drop-zone">
        <input type="file" id="file-input" accept=".pptx,.ppt" hidden />
        <p>📁 拖拽 PPT 文件到这里，或 <label for="file-input" class="upload-link">点击选择</label></p>
        <p class="hint">支持 .pptx 格式，自动转换为在线幻灯片</p>
      </div>
      <div id="upload-status" class="hidden">
        <div class="progress-bar">
          <div class="progress-fill" id="progress-fill"></div>
        </div>
        <p id="status-text">准备中...</p>
      </div>
    </div>

    <!-- 幻灯片列表 -->
    <div class="slides-section">
      <h2>已上传的文件</h2>
      <div id="slides-list" class="slides-grid"></div>
      <p id="empty-state" class="empty-state hidden">还没有文件，上传第一个吧！</p>
    </div>

    <!-- 幻灯片查看器 -->
    <div id="viewer" class="viewer hidden">
      <div class="viewer-header">
        <button id="close-viewer" class="btn-close">← 返回</button>
        <h3 id="viewer-title"></h3>
        <div class="viewer-nav">
          <button id="prev-slide" class="btn-nav">◀</button>
          <span id="slide-counter">1 / 1</span>
          <button id="next-slide" class="btn-nav">▶</button>
        </div>
      </div>
      <div class="slide-container">
        <div class="slide-content" id="slide-content"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 模态框 */
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }

  .modal-content {
    background: var(--color-surface);
    padding: 2rem;
    border-radius: 12px;
    text-align: center;
    max-width: 400px;
    width: 90%;
  }

  .modal-content h2 {
    margin-bottom: 1rem;
  }

  .modal-content p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .modal-content input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .btn-primary {
    width: 100%;
    padding: 0.75rem;
    background: var(--color-accent);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .error {
    color: #ef4444;
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  /* 主内容 */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .header h1 {
    font-size: 1.75rem;
  }

  .btn-logout {
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .btn-logout:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* 上传区域 */
  .upload-section {
    margin-bottom: 3rem;
  }

  .upload-area {
    border: 2px dashed var(--color-border);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s;
  }

  .upload-area:hover, .upload-area.dragover {
    border-color: var(--color-accent);
    background: var(--color-surface);
  }

  .upload-link {
    color: var(--color-accent);
    cursor: pointer;
    text-decoration: underline;
  }

  .hint {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  .progress-bar {
    height: 4px;
    background: var(--color-border);
    border-radius: 2px;
    margin: 1rem 0;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-accent);
    width: 0%;
    transition: width 0.3s;
  }

  /* 幻灯片网格 */
  .slides-section {
    margin-bottom: 3rem;
  }

  .slides-section h2 {
    margin-bottom: 1.5rem;
  }

  .slides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .slide-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s;
  }

  .slide-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .slide-cover {
    height: 120px;
    background: linear-gradient(135deg, var(--color-accent), #8b5cf6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
  }

  .slide-info {
    padding: 1rem;
  }

  .slide-info h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .slide-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--color-text-muted);
  }

  /* 查看器 */
  .viewer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-bg);
    z-index: 100;
    display: flex;
    flex-direction: column;
  }

  .viewer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .viewer-header h3 {
    flex: 1;
    text-align: center;
  }

  .btn-close, .btn-nav {
    padding: 0.5rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    cursor: pointer;
  }

  .btn-close:hover, .btn-nav:hover {
    background: var(--color-surface-hover);
  }

  .viewer-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  #slide-counter {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    min-width: 60px;
    text-align: center;
  }

  .slide-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .slide-content {
    max-width: 1000px;
    width: 100%;
    aspect-ratio: 16/9;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
  }

  .slide-content h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .slide-content ul {
    text-align: left;
    max-width: 600px;
  }

  .slide-content li {
    margin: 0.5rem 0;
    color: var(--color-text-muted);
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  // 配置
  const API_BASE = '/api';
  const STORAGE_KEY = 'slides_auth';

  // 状态
  let isAuthenticated = false;
  let allSlides = [];
  let currentSlide = null;
  let currentIndex = 0;

  // DOM 元素
  const loginModal = document.getElementById('login-modal')!;
  const mainContent = document.getElementById('main-content')!;
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const loginBtn = document.getElementById('login-btn')!;
  const loginError = document.getElementById('login-error')!;
  const logoutBtn = document.getElementById('logout-btn')!;
  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const uploadStatus = document.getElementById('upload-status')!;
  const progressFill = document.getElementById('progress-fill')!;
  const statusText = document.getElementById('status-text')!;
  const slidesList = document.getElementById('slides-list')!;
  const emptyState = document.getElementById('empty-state')!;
  const viewer = document.getElementById('viewer')!;
  const viewerTitle = document.getElementById('viewer-title')!;
  const slideContent = document.getElementById('slide-content')!;
  const slideCounter = document.getElementById('slide-counter')!;
  const closeViewer = document.getElementById('close-viewer')!;
  const prevSlide = document.getElementById('prev-slide')!;
  const nextSlide = document.getElementById('next-slide')!;

  // 初始化
  function init() {
    const token = sessionStorage.getItem(STORAGE_KEY);
    if (token) {
      verifyToken(token);
    }

    // 事件绑定
    loginBtn.addEventListener('click', handleLogin);
    passwordInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') handleLogin();
    });
    logoutBtn.addEventListener('click', handleLogout);
    dropZone.addEventListener('dragover', handleDragOver);
    dropZone.addEventListener('dragleave', handleDragLeave);
    dropZone.addEventListener('drop', handleDrop);
    fileInput.addEventListener('change', handleFileSelect);
    closeViewer.addEventListener('click', closeViewerPanel);
    prevSlide.addEventListener('click', showPrevSlide);
    nextSlide.addEventListener('click', showNextSlide);
    document.addEventListener('keydown', handleKeyboard);
  }

  // 登录处理
  async function handleLogin() {
    const password = passwordInput.value.trim();
    if (!password) return;

    // 尝试 API 验证
    try {
      const response = await fetch(`${API_BASE}/auth`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });

      const data = await response.json();

      if (data.success) {
        isAuthenticated = true;
        sessionStorage.setItem(STORAGE_KEY, data.token);
        showMainContent();
        loadSlides();
      } else {
        loginError.classList.remove('hidden');
        passwordInput.value = '';
      }
    } catch (error) {
      // API 不可用时的提示
      loginError.textContent = '连接服务器失败，请稍后重试';
      loginError.classList.remove('hidden');
      passwordInput.value = '';
    }
  }

  // 验证 token
  async function verifyToken(token: string) {
    try {
      const response = await fetch(`${API_BASE}/slides`, {
        headers: { 'Authorization': `Bearer ${token}` },
      });

      if (response.ok) {
        isAuthenticated = true;
        showMainContent();
        loadSlides();
      } else {
        sessionStorage.removeItem(STORAGE_KEY);
        loginModal.classList.remove('hidden');
        mainContent.classList.add('hidden');
      }
    } catch (error) {
      // API 不可用时，需要重新登录
      sessionStorage.removeItem(STORAGE_KEY);
      loginModal.classList.remove('hidden');
      mainContent.classList.add('hidden');
    }
  }

  // 显示主内容
  function showMainContent() {
    loginModal.classList.add('hidden');
    mainContent.classList.remove('hidden');
  }

  // 登出
  function handleLogout() {
    isAuthenticated = false;
    sessionStorage.removeItem(STORAGE_KEY);
    loginModal.classList.remove('hidden');
    mainContent.classList.add('hidden');
    passwordInput.value = '';
  }

  // 拖拽处理
  function handleDragOver(e: DragEvent) {
    e.preventDefault();
    dropZone.classList.add('dragover');
  }

  function handleDragLeave() {
    dropZone.classList.remove('dragover');
  }

  function handleDrop(e: DragEvent) {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    const files = e.dataTransfer?.files;
    if (files) processFiles(files);
  }

  function handleFileSelect(e: Event) {
    const input = e.target as HTMLInputElement;
    if (input.files) processFiles(input.files);
  }

  // 处理文件
  async function processFiles(files: FileList) {
    for (const file of Array.from(files)) {
      if (!file.name.endsWith('.pptx')) {
        alert('请上传 .pptx 格式的文件');
        continue;
      }
      await uploadFile(file);
    }
    loadSlides();
  }

  // 上传文件
  async function uploadFile(file: File) {
    uploadStatus.classList.remove('hidden');
    statusText.textContent = `正在处理: ${file.name}`;
    progressFill.style.width = '0%';

    try {
      // 解析 PPT
      const JSZip = await import('jszip');
      const zip = await JSZip.loadAsync(file);

      const slideFiles: string[] = [];
      zip.forEach((path) => {
        if (path.match(/ppt\/slides\/slide\d+\.xml$/)) {
          slideFiles.push(path);
        }
      });

      slideFiles.sort();
      const slides = [];

      for (let i = 0; i < slideFiles.length; i++) {
        progressFill.style.width = `${((i + 1) / slideFiles.length) * 100}%`;
        statusText.textContent = `解析幻灯片 ${i + 1}/${slideFiles.length}...`;

        const xml = await zip.file(slideFiles[i])!.async('text');
        const parser = new DOMParser();
        const doc = parser.parseFromString(xml, 'text/xml');

        const texts: string[] = [];
        doc.querySelectorAll('a:t').forEach(t => {
          const text = t.textContent?.trim();
          if (text) texts.push(text);
        });

        slides.push({
          title: texts[0] || `幻灯片 ${i + 1}`,
          content: texts.slice(1).join('\n') || texts[0] || ''
        });
      }

      // 尝试上传到服务器
      const token = sessionStorage.getItem(STORAGE_KEY);
      const slideData = {
        title: file.name.replace(/\.(pptx|ppt)$/, ''),
        fileName: file.name,
        slides,
      };

      try {
        const response = await fetch(`${API_BASE}/slides`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`,
          },
          body: JSON.stringify(slideData),
        });

        if (response.ok) {
          statusText.textContent = '✓ 上传成功！';
        } else {
          throw new Error('服务器错误');
        }
      } catch (error) {
        // 服务器不可用，保存到本地
        saveSlideLocal({
          id: Date.now().toString(),
          ...slideData,
          date: new Date().toLocaleDateString('zh-CN'),
        });
        statusText.textContent = '✓ 已保存到本地';
      }

      setTimeout(() => {
        uploadStatus.classList.add('hidden');
      }, 2000);

    } catch (error) {
      console.error('解析失败:', error);
      statusText.textContent = '✗ 解析失败，请检查文件格式';
    }
  }

  // 本地存储操作
  function getSlidesLocal() {
    const data = localStorage.getItem('annual_slides');
    return data ? JSON.parse(data) : [];
  }

  function saveSlideLocal(slide: any) {
    const slides = getSlidesLocal();
    slides.unshift(slide);
    localStorage.setItem('annual_slides', JSON.stringify(slides));
  }

  function deleteSlideLocal(id: string) {
    const slides = getSlidesLocal().filter((s: any) => s.id !== id);
    localStorage.setItem('annual_slides', JSON.stringify(slides));
  }

  // 加载幻灯片
  async function loadSlides() {
    try {
      const token = sessionStorage.getItem(STORAGE_KEY);
      const response = await fetch(`${API_BASE}/slides`, {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      allSlides = await response.json();
    } catch (error) {
      allSlides = getSlidesLocal();
    }
    renderSlidesList();
  }

  function loadSlidesLocal() {
    allSlides = getSlidesLocal();
    renderSlidesList();
  }

  // 渲染列表
  function renderSlidesList() {
    if (allSlides.length === 0) {
      slidesList.innerHTML = '';
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    slidesList.innerHTML = allSlides.map(slide => `
      <div class="slide-card" data-id="${slide.id}">
        <div class="slide-cover">📊</div>
        <div class="slide-info">
          <h3>${slide.title}</h3>
          <div class="slide-meta">
            <span>${slide.slides?.length || 0} 页</span>
            <span>${slide.date}</span>
          </div>
        </div>
      </div>
    `).join('');

    // 绑定点击事件
    slidesList.querySelectorAll('.slide-card').forEach(card => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-id');
        const slide = allSlides.find(s => s.id === id);
        if (slide) openViewer(slide);
      });
    });
  }

  // 打开查看器
  function openViewer(slide: any) {
    currentSlide = slide;
    currentIndex = 0;
    viewerTitle.textContent = slide.title;
    viewer.classList.remove('hidden');
    renderSlide();
  }

  // 渲染幻灯片
  function renderSlide() {
    if (!currentSlide) return;

    const slide = currentSlide.slides[currentIndex];
    slideCounter.textContent = `${currentIndex + 1} / ${currentSlide.slides.length}`;

    const lines = slide.content.split('\n');
    let html = '';

    if (slide.title) {
      html += `<h2>${slide.title}</h2>`;
    }

    if (lines.length > 1) {
      html += '<ul>' + lines.map(l => `<li>${l}</li>`).join('') + '</ul>';
    } else {
      html += `<p style="font-size: 1.25rem;">${slide.content}</p>`;
    }

    slideContent.innerHTML = html;
  }

  // 关闭查看器
  function closeViewerPanel() {
    viewer.classList.add('hidden');
    currentSlide = null;
  }

  // 上一页/下一页
  function showPrevSlide() {
    if (currentIndex > 0) {
      currentIndex--;
      renderSlide();
    }
  }

  function showNextSlide() {
    if (currentSlide && currentIndex < currentSlide.slides.length - 1) {
      currentIndex++;
      renderSlide();
    }
  }

  // 键盘导航
  function handleKeyboard(e: KeyboardEvent) {
    if (!currentSlide) return;
    if (e.key === 'ArrowLeft') showPrevSlide();
    if (e.key === 'ArrowRight') showNextSlide();
    if (e.key === 'Escape') closeViewerPanel();
  }

  // 启动
  init();
</script>
