---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="网址后台" description="内部管理后台">
  <!-- 登录模态框 -->
  <div id="login-modal" class="modal">
    <div class="modal-content">
      <h2>🔐 访问验证</h2>
      <p>请输入访问密码</p>
      <input type="password" id="password-input" placeholder="请输入密码" />
      <button id="login-btn" class="btn-primary">验证</button>
      <p id="login-error" class="error hidden">密码错误，请重试</p>
    </div>
  </div>

  <!-- 主内容 -->
  <div id="main-content" class="hidden">
    <div class="admin-layout">
      <!-- 侧边栏 -->
      <aside class="sidebar">
        <div class="sidebar-header">
          <h2>🔧 网址后台</h2>
        </div>
        <nav class="sidebar-nav">
          <button class="nav-item active" data-section="annual">
            <span class="nav-icon">📊</span>
            <span>年度总结</span>
          </button>
          <button class="nav-item" data-section="diary">
            <span class="nav-icon">📔</span>
            <span>工作日记</span>
          </button>
          <button class="nav-item" data-section="notes">
            <span class="nav-icon">📝</span>
            <span>临时笔记</span>
          </button>
        </nav>
        <div class="sidebar-footer">
          <a href="/" class="back-link">← 返回主页</a>
          <button id="logout-btn" class="logout-btn">退出登录</button>
        </div>
      </aside>

      <!-- 主区域 -->
      <main class="admin-main">
        <!-- 年度总结板块 -->
        <section id="section-annual" class="admin-section active">
          <div class="section-header">
            <h1>📊 年度总结</h1>
            <p>管理工作年度总结文档</p>
          </div>
          <div class="upload-area" id="drop-zone-annual">
            <input type="file" id="file-input-annual" accept=".pptx,.ppt,.docx,.doc,.xlsx,.xls,.html,.htm" hidden multiple />
            <p>📁 拖拽文件到这里，或 <label for="file-input-annual" class="upload-link">点击选择</label></p>
            <p class="hint">支持 PPT、Word、Excel、HTML 格式</p>
          </div>
          <div id="upload-status" class="hidden">
            <div class="progress-bar">
              <div class="progress-fill" id="progress-fill"></div>
            </div>
            <p id="status-text">准备中...</p>
          </div>
          <div class="files-section">
            <h3>已上传的文件</h3>
            <div id="files-list-annual" class="files-grid"></div>
            <p id="empty-annual" class="empty-state">还没有文件，上传第一个吧！</p>
          </div>
        </section>

        <!-- 工作日记板块 -->
        <section id="section-diary" class="admin-section">
          <div class="section-header">
            <h1>📔 工作日记</h1>
            <p>记录日常工作内容</p>
          </div>
          <div class="diary-editor">
            <input type="date" id="diary-date" class="diary-date" />
            <textarea id="diary-content" class="diary-textarea" placeholder="今天的工作内容..."></textarea>
            <button id="save-diary" class="btn-primary">保存日记</button>
          </div>
          <div class="files-section">
            <h3>历史日记</h3>
            <div id="diary-list" class="diary-list"></div>
            <p id="empty-diary" class="empty-state">还没有日记，开始记录吧！</p>
          </div>
        </section>

        <!-- 临时笔记板块 -->
        <section id="section-notes" class="admin-section">
          <div class="section-header">
            <h1>📝 临时笔记</h1>
            <p>快速记录临时想法</p>
          </div>
          <div class="note-editor">
            <input type="text" id="note-title" class="note-title" placeholder="标题" />
            <textarea id="note-content" class="note-textarea" placeholder="笔记内容..."></textarea>
            <button id="save-note" class="btn-primary">保存笔记</button>
          </div>
          <div class="files-section">
            <h3>所有笔记</h3>
            <div id="notes-list" class="notes-grid"></div>
            <p id="empty-notes" class="empty-state">还没有笔记，开始记录吧！</p>
          </div>
        </section>
      </main>
    </div>

    <!-- 文件查看器模态框 -->
    <div id="viewer-modal" class="viewer-modal hidden">
      <div class="viewer-container">
        <div class="viewer-header">
          <button id="close-viewer" class="btn-close">← 关闭</button>
          <h3 id="viewer-title"></h3>
          <div class="viewer-nav">
            <button id="prev-slide" class="btn-nav">◀</button>
            <span id="slide-counter">1 / 1</span>
            <button id="next-slide" class="btn-nav">▶</button>
          </div>
        </div>
        <div class="viewer-content" id="viewer-content"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 模态框 */
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }

  .modal-content {
    background: var(--color-surface);
    padding: 2rem;
    border-radius: 12px;
    text-align: center;
    max-width: 400px;
    width: 90%;
  }

  .modal-content h2 {
    margin-bottom: 1rem;
  }

  .modal-content p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .modal-content input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .btn-primary {
    width: 100%;
    padding: 0.75rem;
    background: var(--color-accent);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .error {
    color: #ef4444;
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  /* 管理后台布局 */
  .admin-layout {
    display: flex;
    min-height: calc(100vh - var(--nav-height) - 4rem);
    gap: 2rem;
  }

  /* 侧边栏 */
  .sidebar {
    width: 240px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .sidebar-header h2 {
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .sidebar-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
    font-size: 0.95rem;
  }

  .nav-item:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  .nav-item.active {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  .nav-icon {
    font-size: 1.25rem;
  }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .back-link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .logout-btn {
    padding: 0.5rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: 0.875rem;
  }

  .logout-btn:hover {
    border-color: #ef4444;
    color: #ef4444;
  }

  /* 主区域 */
  .admin-main {
    flex: 1;
    min-width: 0;
  }

  .admin-section {
    display: none;
  }

  .admin-section.active {
    display: block;
  }

  .section-header {
    margin-bottom: 2rem;
  }

  .section-header h1 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .section-header p {
    color: var(--color-text-muted);
  }

  /* 上传区域 */
  .upload-area {
    border: 2px dashed var(--color-border);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s;
    margin-bottom: 2rem;
  }

  .upload-area:hover, .upload-area.dragover {
    border-color: var(--color-accent);
    background: var(--color-surface);
  }

  .upload-link {
    color: var(--color-accent);
    cursor: pointer;
    text-decoration: underline;
  }

  .hint {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  .progress-bar {
    height: 4px;
    background: var(--color-border);
    border-radius: 2px;
    margin: 1rem 0;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-accent);
    width: 0%;
    transition: width 0.3s;
  }

  /* 文件列表 */
  .files-section {
    margin-top: 2rem;
  }

  .files-section h3 {
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .files-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .file-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .file-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .file-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .file-info {
    flex: 1;
    min-width: 0;
  }

  .file-name {
    font-weight: 600;
    margin-bottom: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-meta {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .file-delete {
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.25rem;
    font-size: 1rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .file-card:hover .file-delete {
    opacity: 1;
  }

  .file-delete:hover {
    color: #ef4444;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border-radius: 12px;
    border: 1px dashed var(--color-border);
  }

  /* 日记编辑器 */
  .diary-editor {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .diary-date {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .diary-textarea {
    width: 100%;
    min-height: 150px;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    margin-bottom: 1rem;
    font-size: 1rem;
    resize: vertical;
    font-family: inherit;
  }

  .diary-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .diary-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .diary-item:hover {
    border-color: var(--color-accent);
  }

  .diary-item-date {
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-accent);
  }

  .diary-item-preview {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 笔记编辑器 */
  .note-editor {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .note-title {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .note-textarea {
    width: 100%;
    min-height: 120px;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    margin-bottom: 1rem;
    font-size: 1rem;
    resize: vertical;
    font-family: inherit;
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .note-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .note-card:hover {
    border-color: var(--color-accent);
  }

  .note-card-title {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .note-card-preview {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 查看器模态框 */
  .viewer-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .viewer-container {
    width: 90%;
    max-width: 1200px;
    height: 90vh;
    display: flex;
    flex-direction: column;
  }

  .viewer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    color: white;
  }

  .btn-close {
    padding: 0.5rem 1rem;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 6px;
    color: white;
    cursor: pointer;
  }

  .btn-close:hover {
    background: rgba(255,255,255,0.2);
  }

  .viewer-header h3 {
    flex: 1;
    text-align: center;
  }

  .viewer-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-nav {
    padding: 0.5rem 1rem;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 6px;
    color: white;
    cursor: pointer;
  }

  .btn-nav:hover {
    background: rgba(255,255,255,0.2);
  }

  #slide-counter {
    color: rgba(255,255,255,0.7);
    min-width: 60px;
    text-align: center;
  }

  .viewer-content {
    flex: 1;
    background: white;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    overflow: auto;
  }

  .viewer-content .slide-page {
    max-width: 100%;
    max-height: 100%;
  }

  .viewer-content h2 {
    color: #333;
    margin-bottom: 1rem;
  }

  .viewer-content p, .viewer-content li {
    color: #555;
    line-height: 1.8;
  }

  .hidden {
    display: none !important;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .admin-layout {
      flex-direction: column;
    }

    .sidebar {
      width: 100%;
      flex-direction: row;
      overflow-x: auto;
      padding: 1rem;
    }

    .sidebar-header {
      display: none;
    }

    .sidebar-nav {
      flex-direction: row;
      gap: 0.5rem;
    }

    .nav-item {
      white-space: nowrap;
    }

    .sidebar-footer {
      margin-top: 0;
      padding-top: 0;
      border-top: none;
      padding-left: 1rem;
      border-left: 1px solid var(--color-border);
      margin-left: 1rem;
      flex-direction: row;
      align-items: center;
    }
  }
</style>

<script>
  const API_BASE = '/api';
  const AUTH_KEY = 'admin_auth';
  const DIARY_KEY = 'admin_diary';
  const NOTES_KEY = 'admin_notes';

  // 状态
  let isAuthenticated = false;
  let currentSection = 'annual';

  // DOM 元素
  const loginModal = document.getElementById('login-modal')!;
  const mainContent = document.getElementById('main-content')!;
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const loginBtn = document.getElementById('login-btn')!;
  const loginError = document.getElementById('login-error')!;
  const logoutBtn = document.getElementById('logout-btn')!;
  const navItems = document.querySelectorAll('.nav-item');

  // 初始化
  function init() {
    const token = sessionStorage.getItem(AUTH_KEY);
    if (token) {
      isAuthenticated = true;
      showMainContent();
    }

    // 事件绑定
    loginBtn.addEventListener('click', handleLogin);
    passwordInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') handleLogin();
    });
    logoutBtn.addEventListener('click', handleLogout);

    // 导航切换
    navItems.forEach(item => {
      item.addEventListener('click', () => {
        const section = item.getAttribute('data-section');
        if (section) switchSection(section);
      });
    });

    // 设置今日日期
    document.getElementById('diary-date').valueAsDate = new Date();

    // 加载数据
    loadDiary();
    loadNotes();
    loadFiles();
  }

  // 登录
  async function handleLogin() {
    const password = passwordInput.value.trim();
    if (!password) return;

    try {
      const response = await fetch(`${API_BASE}/auth`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });

      const data = await response.json();
      if (data.success) {
        isAuthenticated = true;
        sessionStorage.setItem(AUTH_KEY, data.token);
        showMainContent();
      } else {
        loginError.classList.remove('hidden');
        passwordInput.value = '';
      }
    } catch (error) {
      loginError.textContent = '连接失败，请稍后重试';
      loginError.classList.remove('hidden');
    }
  }

  // 显示主内容
  function showMainContent() {
    loginModal.classList.add('hidden');
    mainContent.classList.remove('hidden');
  }

  // 登出
  function handleLogout() {
    isAuthenticated = false;
    sessionStorage.removeItem(AUTH_KEY);
    window.location.href = '/';
  }

  // 切换板块
  function switchSection(section: string) {
    currentSection = section;

    // 更新导航状态
    navItems.forEach(item => {
      item.classList.toggle('active', item.getAttribute('data-section') === section);
    });

    // 更新内容显示
    document.querySelectorAll('.admin-section').forEach(s => {
      s.classList.toggle('active', s.id === `section-${section}`);
    });
  }

  // 文件处理
  const dropZones = ['annual'].map(section => {
    const zone = document.getElementById(`drop-zone-${section}`)!;
    const input = document.getElementById(`file-input-${section}`) as HTMLInputElement;

    zone.addEventListener('dragover', (e) => {
      e.preventDefault();
      zone.classList.add('dragover');
    });

    zone.addEventListener('dragleave', () => {
      zone.classList.remove('dragover');
    });

    zone.addEventListener('drop', (e) => {
      e.preventDefault();
      zone.classList.remove('dragover');
      if (e.dataTransfer?.files) processFiles(e.dataTransfer.files);
    });

    input.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files) processFiles(files);
    });

    return { zone, input };
  });

  async function processFiles(files: FileList) {
    for (const file of Array.from(files)) {
      await uploadFile(file);
    }
    loadFiles();
  }

  async function uploadFile(file: File) {
    const uploadStatus = document.getElementById('upload-status')!;
    const progressFill = document.getElementById('progress-fill')!;
    const statusText = document.getElementById('status-text')!;

    uploadStatus.classList.remove('hidden');
    statusText.textContent = `正在处理: ${file.name}`;
    progressFill.style.width = '10%';

    try {
      const ext = file.name.toLowerCase().split('.').pop();
      let slides: { title: string; content: string }[] = [];

      if (ext === 'pptx' || ext === 'ppt') {
        slides = await parsePPT(file);
      } else if (ext === 'docx' || ext === 'doc') {
        slides = await parseWord(file);
      } else if (ext === 'xlsx' || ext === 'xls') {
        slides = await parseExcel(file);
      } else if (ext === 'html' || ext === 'htm') {
        slides = await parseHTML(file);
      }

      progressFill.style.width = '90%';

      const fileData = {
        id: Date.now().toString(),
        title: file.name.replace(/\.\w+$/, ''),
        fileName: file.name,
        fileType: ext,
        slides,
        date: new Date().toLocaleDateString('zh-CN'),
        section: currentSection,
      };

      // 保存到本地
      const files = getFilesLocal();
      files.unshift(fileData);
      localStorage.setItem('admin_files', JSON.stringify(files));

      statusText.textContent = '✓ 上传成功！';
      progressFill.style.width = '100%';

      setTimeout(() => {
        uploadStatus.classList.add('hidden');
      }, 2000);

    } catch (error) {
      console.error('解析失败:', error);
      statusText.textContent = '✗ 解析失败';
    }
  }

  // 解析函数
  async function parsePPT(file: File) {
    const JSZip = await import('jszip');
    const zip = await JSZip.loadAsync(file);
    const slideFiles: string[] = [];
    zip.forEach(path => {
      if (path.match(/ppt\/slides\/slide\d+\.xml$/)) slideFiles.push(path);
    });
    slideFiles.sort();
    const slides = [];
    for (let i = 0; i < slideFiles.length; i++) {
      const xml = await zip.file(slideFiles[i])!.async('text');
      const parser = new DOMParser();
      const doc = parser.parseFromString(xml, 'text/xml');
      const texts: string[] = [];
      doc.querySelectorAll('a:t').forEach(t => {
        const text = t.textContent?.trim();
        if (text) texts.push(text);
      });
      slides.push({ title: texts[0] || `幻灯片 ${i+1}`, content: texts.slice(1).join('\n') || texts[0] || '' });
    }
    return slides;
  }

  async function parseWord(file: File) {
    const JSZip = await import('jszip');
    const zip = await JSZip.loadAsync(file);
    const docXml = await zip.file('word/document.xml')?.async('text');
    if (!docXml) throw new Error('无法解析');
    const parser = new DOMParser();
    const doc = parser.parseFromString(docXml, 'text/xml');
    const paragraphs: string[] = [];
    doc.querySelectorAll('w:p').forEach(p => {
      const texts: string[] = [];
      p.querySelectorAll('w:t').forEach(t => {
        const text = t.textContent?.trim();
        if (text) texts.push(text);
      });
      if (texts.length > 0) paragraphs.push(texts.join(''));
    });
    return [{ title: '文档内容', content: paragraphs.join('\n\n') || '无法提取内容' }];
  }

  async function parseExcel(file: File) {
    const XLSX = await import('xlsx');
    const data = await file.arrayBuffer();
    const workbook = XLSX.read(data, { type: 'array' });
    const slides = [];
    for (const sheetName of workbook.SheetNames) {
      const sheet = workbook.Sheets[sheetName];
      const jsonData = XLSX.utils.sheet_to_json(sheet, { header: 1 }) as any[][];
      const content = jsonData.filter(row => row.length > 0).map(row => row.join(' | ')).join('\n');
      slides.push({ title: sheetName, content });
    }
    return slides.length > 0 ? slides : [{ title: '表格', content: '无法提取内容' }];
  }

  async function parseHTML(file: File) {
    const html = await file.text();
    const parser = new DOMParser();
    const doc = parser.parseFromString(html, 'text/html');
    const title = doc.querySelector('title')?.textContent || 'HTML 文档';
    const body = doc.querySelector('body');
    const content = body?.innerText || body?.textContent || '无法提取内容';
    return [{ title, content: content.trim() }];
  }

  // 本地存储
  function getFilesLocal() {
    const data = localStorage.getItem('admin_files');
    return data ? JSON.parse(data) : [];
  }

  function deleteFileLocal(id: string) {
    const files = getFilesLocal().filter(f => f.id !== id);
    localStorage.setItem('admin_files', JSON.stringify(files));
    loadFiles();
  }

  function loadFiles() {
    const files = getFilesLocal().filter(f => f.section === currentSection);
    const listEl = document.getElementById(`files-list-${currentSection}`)!;
    const emptyEl = document.getElementById(`empty-${currentSection}`)!;

    if (files.length === 0) {
      listEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    listEl.innerHTML = files.map(file => {
      const icon = file.fileType === 'pptx' || file.fileType === 'ppt' ? '📊' :
                   file.fileType === 'docx' || file.fileType === 'doc' ? '📄' :
                   file.fileType === 'xlsx' || file.fileType === 'xls' ? '📈' : '🌐';
      return `
        <div class="file-card" data-id="${file.id}">
          <span class="file-icon">${icon}</span>
          <div class="file-info">
            <div class="file-name">${file.title}</div>
            <div class="file-meta">${file.slides?.length || 0} 页 · ${file.date}</div>
          </div>
          <button class="file-delete" data-id="${file.id}">✕</button>
        </div>
      `;
    }).join('');

    // 绑定事件
    listEl.querySelectorAll('.file-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).classList.contains('file-delete')) return;
        const id = card.getAttribute('data-id');
        const file = getFilesLocal().find(f => f.id === id);
        if (file) openViewer(file);
      });
    });

    listEl.querySelectorAll('.file-delete').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        if (confirm('确定删除此文件？')) deleteFileLocal(id!);
      });
    });
  }

  // 查看器
  let currentFile: any = null;
  let currentSlideIndex = 0;

  function openViewer(file: any) {
    currentFile = file;
    currentSlideIndex = 0;
    document.getElementById('viewer-title').textContent = file.title;
    document.getElementById('viewer-modal').classList.remove('hidden');
    renderSlide();
  }

  function renderSlide() {
    if (!currentFile) return;
    const slide = currentFile.slides[currentSlideIndex];
    document.getElementById('slide-counter').textContent = `${currentSlideIndex + 1} / ${currentFile.slides.length}`;
    const content = document.getElementById('viewer-content');
    const lines = slide.content.split('\n');
    let html = `<div class="slide-page"><h2>${slide.title}</h2>`;
    if (lines.length > 1) {
      html += '<ul>' + lines.map(l => `<li>${l}</li>`).join('') + '</ul>';
    } else {
      html += `<p>${slide.content}</p>`;
    }
    html += '</div>';
    content.innerHTML = html;
  }

  document.getElementById('close-viewer').addEventListener('click', () => {
    document.getElementById('viewer-modal').classList.add('hidden');
  });

  document.getElementById('prev-slide').addEventListener('click', () => {
    if (currentSlideIndex > 0) { currentSlideIndex--; renderSlide(); }
  });

  document.getElementById('next-slide').addEventListener('click', () => {
    if (currentFile && currentSlideIndex < currentFile.slides.length - 1) { currentSlideIndex++; renderSlide(); }
  });

  // 日记功能
  function loadDiary() {
    const diaries = JSON.parse(localStorage.getItem(DIARY_KEY) || '[]');
    const listEl = document.getElementById('diary-list')!;
    const emptyEl = document.getElementById('empty-diary')!;

    if (diaries.length === 0) {
      listEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    listEl.innerHTML = diaries.map(d => `
      <div class="diary-item" data-date="${d.date}">
        <div class="diary-item-date">${d.date}</div>
        <div class="diary-item-preview">${d.content.substring(0, 100)}...</div>
      </div>
    `).join('');

    listEl.querySelectorAll('.diary-item').forEach(item => {
      item.addEventListener('click', () => {
        const date = item.getAttribute('data-date');
        const diary = diaries.find(d => d.date === date);
        if (diary) {
          document.getElementById('diary-date').value = diary.date;
          document.getElementById('diary-content').value = diary.content;
        }
      });
    });
  }

  document.getElementById('save-diary').addEventListener('click', () => {
    const date = (document.getElementById('diary-date') as HTMLInputElement).value;
    const content = (document.getElementById('diary-content') as HTMLTextAreaElement).value;
    if (!date || !content) { alert('请填写日期和内容'); return; }

    const diaries = JSON.parse(localStorage.getItem(DIARY_KEY) || '[]');
    const existing = diaries.findIndex(d => d.date === date);
    if (existing >= 0) {
      diaries[existing].content = content;
    } else {
      diaries.unshift({ date, content });
    }
    localStorage.setItem(DIARY_KEY, JSON.stringify(diaries));
    loadDiary();
    alert('保存成功！');
  });

  // 笔记功能
  function loadNotes() {
    const notes = JSON.parse(localStorage.getItem(NOTES_KEY) || '[]');
    const listEl = document.getElementById('notes-list')!;
    const emptyEl = document.getElementById('empty-notes')!;

    if (notes.length === 0) {
      listEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    listEl.innerHTML = notes.map(n => `
      <div class="note-card" data-id="${n.id}">
        <div class="note-card-title">${n.title}</div>
        <div class="note-card-preview">${n.content.substring(0, 80)}...</div>
      </div>
    `).join('');

    listEl.querySelectorAll('.note-card').forEach(card => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-id');
        const note = notes.find(n => n.id === id);
        if (note) {
          document.getElementById('note-title').value = note.title;
          document.getElementById('note-content').value = note.content;
        }
      });
    });
  }

  document.getElementById('save-note').addEventListener('click', () => {
    const title = (document.getElementById('note-title') as HTMLInputElement).value;
    const content = (document.getElementById('note-content') as HTMLTextAreaElement).value;
    if (!title || !content) { alert('请填写标题和内容'); return; }

    const notes = JSON.parse(localStorage.getItem(NOTES_KEY) || '[]');
    const newNote = { id: Date.now().toString(), title, content, date: new Date().toLocaleDateString('zh-CN') };
    notes.unshift(newNote);
    localStorage.setItem(NOTES_KEY, JSON.stringify(notes));
    loadNotes();
    (document.getElementById('note-title') as HTMLInputElement).value = '';
    (document.getElementById('note-content') as HTMLTextAreaElement).value = '';
    alert('保存成功！');
  });

  init();
</script>
